.cursor/
.agents/
skills/
mcp.json

# Git worktree（隔离工作区）
.worktrees/

# 发布产物（build-release.ps1 生成）
release/

# 编译产物兜底
# 正式产物统一由 src/build.bat 输出到 release/（上面已忽略）；
# 这里再兜一层，防止误在源码目录构建后把二进制提交进来。
*.exe
*.o
*.obj
*.dll
__pycache__/
*.pyc
