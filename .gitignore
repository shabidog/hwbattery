# 环境变量与密钥（保留 .env.example / .env.template 模板）
.env
.env.*
!.env.example
!.env.template

# 工具缓存 / 会话文件
.codegraph/
.superpowers/

# 日志
logs/
*.log

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# 系统与通用临时文件
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.temp
*~
*.swp
*.bak

#ai
/PROJECT_MEMORY.md
AGENTS.md
CLAUDE.md

# AI 工具的配置、技能与会话缓存（不是项目代码，不入库）
.atomcode/
